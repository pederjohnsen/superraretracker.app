datasource db {
  provider  = 'postgresql'
  url       = env('DATABASE_URL')
  directUrl = env('DATABASE_URL_UNPOOLED')
}

enum ReleaseType {
  SWITCH
  SWITCH2
  PS4
  PS5
  XBOX
}

// A trackable Super Rare Games release, scraped from the store.
model Release {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String                @unique
  // Which publisher's store this is from: a key in src/lib/publishers (e.g. "super-rare-games").
  publisher           String                @default("super-rare-games")
  name                String
  url                 String
  type                ReleaseType
  releaseDate         DateTime
  preOrderCloseDate   DateTime?
  lastStockPercentage Int?
  // Product image from the store (resized by Shopify), shown on the release card.
  coverUrl            String?
  // Exact copies left, for stores that publish them (Lost in Cult). The card
  // shows this when there's no print run to make a percentage from.
  stockCount          Int?
  // Copies made, from the store's description (Lost in Cult). Stock % is
  // stockCount / printRun. Correct it here if the description was misread.
  printRun            Int?
  // The store option this release is, for stores that sell each edition as an
  // option of one product (Lost in Cult).
  variantId           String?
  // Price in minor units of `currency` (3720 for £37.20), from the store.
  pricePence          Int?
  // ISO 4217 currency of the price, the publisher's store currency.
  currency            String                @default("GBP")
  // What the card shows, split from the store title when the release is added.
  // Edit these to fix a title the parser got wrong. When title is empty, the
  // card splits `name` on the fly instead (releases added before these existed).
  title               String?
  catalogue           String?
  edition             String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime?             @updatedAt

  stockChecks         StockCheck[]
  subscriptions       ReleaseSubscription[]
  alerts              Alert[]
  pollSchedule        ReleasePollSchedule?
}

// Tracks when a release is next due for a stock check. The interval adapts to how
// fast the release's stock has been dropping, so fast-selling releases get polled
// more often and slow/stale ones get polled less often.
model ReleasePollSchedule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nextPollAt          DateTime  @default(now())
  intervalMinutes     Int       @default(60)
  lastPolledAt        DateTime?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  release             Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId           String    @unique @db.Uuid

  @@index([nextPollAt])
}

// Historical record of stock percentage readings for a release, captured by the scraper.
model StockCheck {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  percentage Int
  checkedAt  DateTime @default(now())

  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId  String   @db.Uuid

  @@index([releaseId, checkedAt])
}

// A browser's Web Push subscription, registered from the PWA.
model PushSubscription {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String?               @unique
  endpoint      String                @unique
  p256dh        String
  auth          String
  createdAt     DateTime              @default(now())

  subscriptions ReleaseSubscription[]
  alerts        Alert[]
}

// Links a push subscription to a release with the stock threshold that should trigger a notification.
model ReleaseSubscription {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thresholdPercentage Int
  notifiedAt          DateTime?
  // Stock % when the alert was sent, for "Alert sent at 24%" on the card.
  notifiedPercentage  Int?
  createdAt           DateTime         @default(now())

  release             Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId           String           @db.Uuid

  pushSubscription    PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  pushSubscriptionId  String           @db.Uuid

  @@unique([releaseId, pushSubscriptionId])
}

enum AlertKind {
  STOCK
  RESTOCK
}

// Every alert sent to a device, so the app can show the ones it hasn't seen
// yet ("2 new alerts since your last visit"), even if the notification was
// swiped away or never arrived. Linked to the device and the release rather
// than the subscription, so changing the alert level or untracking doesn't
// erase what was sent. Kept for 30 days.
model Alert {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind               AlertKind
  // Stock % when the alert was sent.
  percentage         Int
  sentAt             DateTime         @default(now())
  // When this device's app first showed it; null until then.
  seenAt             DateTime?

  release            Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId          String           @db.Uuid

  pushSubscription   PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  pushSubscriptionId String           @db.Uuid

  @@index([pushSubscriptionId, seenAt])
  @@index([sentAt])
}
